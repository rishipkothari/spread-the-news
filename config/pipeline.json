{
  "methods": {
    "sources": "blob-json",
    "fetch": "rss",
    "cluster": "llm-single-pass",
    "rank": "headline-index-v1",
    "extract": "chain-v2",
    "analyze": "haiku-facts-v1",
    "synthesize": "sonnet-synthesis-v1",
    "plan": "word-budget-v1",
    "script": "neutral-v1",
    "check": "quote-trace-v1"
  },
  "models": {
    "cluster": "claude-sonnet-5-5",
    "analyze": "claude-haiku-5-5",
    "synthesize": "claude-sonnet-5-5",
    "script": "claude-sonnet-5-5",
    "check": "claude-sonnet-5-5"
  },
  "pricingPerMTok": {
    "claude-sonnet-5-5": {
      "input": 2.0,
      "output": 10.0,
      "cacheRead": 0.1,
      "cacheWrite": 2.5
    },
    "claude-haiku-5-5": {
      "input": 0.1,
      "output": 0.5,
      "cacheRead": 0.01,
      "cacheWrite": 0.125
    },
    "claude-opus-5-5": {
      "input": 4.0,
      "output": 20.0,
      "cacheRead": 0.2,
      "cacheWrite": 5.0
    }
  },
  "ranking": {
    "weights": {
      "coverage": 0.5,
      "balance": 0.25,
      "prominence": 0.25
    },
    "skewPenalty": 0.5,
    "recencyHalfLifeHours": 24,
    "opinionWeight": 0.5,
    "minOutlets": 2,
    "prominence": {
      "_note": "Per outlet, the strongest signal for the story; P = mean over covering outlets.",
      "homepageLead": 1.0,
      "homepageFeatured": 0.7,
      "homepageListed": 0.5,
      "topFeed": 0.8,
      "latestFeed": 0.25,
      "sectionFeed": 0.15,
      "leadRank": 10,
      "featuredRank": 40
    }
  },
  "fetch": {
    "windowHours": 24,
    "timeoutMs": 15000,
    "userAgent": "SpreadTheNewsBot/0.1 (personal podcast; RSS reader)",
    "maxSummaryChars": 400,
    "homepage": true
  },
  "cluster": {
    "minOutletsPerStory": 2,
    "maxTokens": 48000,
    "effort": "medium"
  },
  "historyDays": 14,
  "failurePolicy": {
    "minSourcesOk": 8,
    "minStoriesChecked": 5
  },
  "vanilla": {
    "lean": 0,
    "categories": "all",
    "targetDurationSec": 780,
    "storyCount": {
      "min": 8,
      "max": 10
    },
    "orderStrategy": "rank",
    "scriptStyle": "neutral-v1"
  },
  "analysis": {
    "_note": "Phase 1. Stories selected = top N ranked; articles per story capped, picked round-robin across outlets.",
    "topStories": 15,
    "maxArticlesPerStory": 8,
    "minTextChars": 800,
    "maxCharsForLlm": 15000,
    "extractConcurrency": 4,
    "paywallPhrases": [
      "subscribe to continue",
      "subscribers only",
      "already a subscriber",
      "to continue reading",
      "create a free account",
      "sign in to read",
      "this content is for subscribers"
    ],
    "analyzeEffort": "low",
    "synthesizeEffort": "medium",
    "analyzeMaxTokens": 8000,
    "synthesizeMaxTokens": 16000,
    "skipPageFetch": [
      "thehill"
    ],
    "analyzeConcurrency": 2,
    "llmMaxRetries": 8
  },
  "script": {
    "_note": "Phase 2. Word budgets at ~150 spoken words a minute; the lead story gets more. Short episodes are fine: budgets are capped, never padded.",
    "wordsPerMinute": 150,
    "leadWords": 300,
    "storyWords": 170,
    "minStoryWords": 90,
    "introOutroWords": 60,
    "includeRecently": false,
    "writeEffort": "medium",
    "checkEffort": "medium",
    "maxTokens": 16000,
    "_templates": "Fixed (non-LLM) segments around the stories, in this order: welcome, rundown, [stories], outro. Remove a kind from 'templates' to drop it; {stories} in the rundown becomes the top 'rundownTop' story titles, plus 'and more' when there are others.",
    "templates": [
      "welcome",
      "rundown",
      "outro"
    ],
    "welcome": "This is Spread the News, where we read across the spectrum so you don't have to.",
    "rundown": "Here's what's up today: {stories}.",
    "outro": "That's the news for today. This has been Spread the News. Catch you tomorrow.",
    "maxAttempts": 3,
    "maxHeadlines": 12,
    "rundownTop": 3
  }
}
